# ==============================================================================
# PS-019: Privacy Intelligence Engine — Environment Configuration Template
# ==============================================================================
# NOTE: This application operates 100% locally and offline without paid APIs,
# cloud dependencies, or external database credentials.
#
# To configure local runtime overrides:
#   1. Copy this file: cp .env.example .env
#   2. Adjust values below as needed for your local environment.
#
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR PERSONAL DATA TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_SERVER_HEADLESS=true

# Scanner Row Sampling Limit (Default: 100 non-null rows per column)
SCANNER_SAMPLE_LIMIT=100

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Local Storage Paths (Optional Overrides)
# DATA_DIR=./data
# CONFIG_DIR=./config
# REPORTS_DIR=./reports
